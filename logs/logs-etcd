    oc adm node-logs $n --path=kube-apiserver/$f
  done
done | sed 's/^[^{]*//' | jq -R -r 'fromjson? |
  select(.requestReceivedTimestamp > "2026-10-23T12:15" and .requestReceivedTimestamp < "2026-10-23T12:35")
  | select(.verb|test("create|update|patch|delete"))
